{
  "version": 2,
  "name": "magic-scuttle",
  "buildCommand": "npx vite build --config vite.config.vercel.ts",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://magic-scuttle.replit.app/api/:path*"
    }
  ]
}
